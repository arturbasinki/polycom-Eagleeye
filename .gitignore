# Environment and build artifacts
.venv/
__pycache__/
*.pyc

# ONNX models - downloaded by install.sh (36 MB, not kept in the repo)
models/*.onnx

# Test reference images - fetched automatically on first run
models/testdata/

# Dot files and directories (tools, agents, editors) - except .gitignore itself
.*
!.gitignore

# Working documentation (plans and specs) - not needed to run the app
docs/

# Camera captures and recorded sessions - they can show people and interiors, so they are not published
captures/

# Photos of the hardware (serial number of the author's unit)
resources/

# Session marker left in the working directory by an editor tool
:memory:.ses
